# Copier en `.env` pour un test local ; sur la borne, ces variables sont
# injectées par le dashboard Fliphetic. NE PAS committer de `.env`.

# --- Base de données (le mot de passe est un SECRET) ---
POSTGRES_DB=flipper
POSTGRES_USER=flipper_user
POSTGRES_PASSWORD=change-me

# --- Tags d'images (laisser par défaut pour suivre main) ---
FRONT_IMAGE_TAG=main-latest
BACKEND_IMAGE_TAG=latest

# --- Divers ---
LOG_LEVEL=INFO
